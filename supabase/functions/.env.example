# Edge Function secrets. Set them with `supabase secrets set NAME=value` (or scripts/set-secret.sh), never commit real values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically in deployed functions.
# For local `supabase functions serve`, copy this file to .env (git-ignored) and fill it in.

# --- Required for the AI features ---
GEMINI_API_KEY=
# GEMINI_DAILY_CAP=500     # max Gemini calls per UTC day for the WHOLE deployment (all users); default 500. Also use a billing-capped key + a Google Cloud budget alert.
# GEMINI_MODEL=            # optional; tried first, then the built-in fallback chain in _shared/config.ts

# --- Web push (generate a pair with `npx web-push generate-vapid-keys`) ---
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# --- App wiring ---
MINIAPP_URL=https://your-host.example/          # used for invite links
ALLOWED_ORIGINS=https://your-host.example       # comma-separated browser origins allowed by CORS
DEFAULT_TZ=UTC                                  # IANA zone for new users
DEFAULT_CURRENCY=USD                            # CNY | KZT | USD

# --- Auth hardening ---
# RATE_SALT=                # random string salting the IP hashes of the auth rate limiter (if unset it is derived from the service-role key)
# ALLOW_QUERY_TOKEN=1       # accept ?token= on webhooks (off by default: URLs end up in logs/history); prefer the X-Token header
# DEBUG=1                   # log raw Shortcut payloads in body-webhook (health data); leave unset

# --- Optional: GitHub contribution graph on the Work tab (classic token, read:user) ---
# GITHUB_TOKEN=

# --- Optional legacy Telegram module (see docs/telegram.md); leave empty to run without it ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=     # random string; the bot rejects webhooks without it
# FIRST_OWNER_TG_ID=           # only this Telegram id may claim an empty database (still prefer scripts/bootstrap-owner.sql first)
# BOT_USERNAME=
