# Miniapp build-time config (copy to .env.local). No secrets here: everything is public in the built bundle.
VITE_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
# Path prefix if hosted under a sub-path (GitHub Pages project site: /your-repo/). Default "/".
# VITE_BASE=/
# Only for the legacy Telegram module:
# VITE_BOT_USERNAME=your_bot
